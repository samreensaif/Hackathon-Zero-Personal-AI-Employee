# ============================================
# AI Employee Vault - Silver Tier
# Copy this file to .env and fill in your values
# ============================================

# --- Anthropic (Claude API) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Gmail API ---
GMAIL_CREDENTIALS_PATH=E:\Hackathon-Zero\Silver-Tier\AI-Employee-Vault\credentials.json
GMAIL_TOKEN_PATH=E:\Hackathon-Zero\Silver-Tier\AI-Employee-Vault\token.json
GMAIL_CHECK_INTERVAL=20

# --- LinkedIn API ---
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
LINKEDIN_AUTHOR_URN=urn:li:person:YOUR_ID
LINKEDIN_POST_MAX_PER_WEEK=3
LINKEDIN_POSTING_DAYS=Tuesday,Thursday
LINKEDIN_OPTIMAL_HOURS=9-11

# --- MCP Server ---
MCP_SERVER_PORT=3000
GMAIL_MCP_TOKEN_PATH=E:\Hackathon-Zero\Silver-Tier\AI-Employee-Vault\token_mcp.json

# --- File System Watcher ---
INBOX_WATCH_PATH=E:\Hackathon-Zero\Silver-Tier\AI-Employee-Vault\Inbox
FILE_CHECK_INTERVAL=10

# --- Orchestrator ---
ORCHESTRATOR_CHECK_INTERVAL=30

# --- Approval Manager ---
APPROVAL_CHECK_INTERVAL=10

# --- Task Scheduler ---
SCHEDULER_HEALTH_CHECK_INTERVAL=60

# --- Vault Paths (Silver Tier) ---
VAULT_ROOT=E:\Hackathon-Zero\Silver-Tier\AI-Employee-Vault
INBOX_DIR=E:\Hackathon-Zero\Silver-Tier\AI-Employee-Vault\Inbox
NEEDS_ACTION_DIR=E:\Hackathon-Zero\Silver-Tier\AI-Employee-Vault\Needs_Action
PENDING_APPROVAL_DIR=E:\Hackathon-Zero\Silver-Tier\AI-Employee-Vault\Pending_Approval
APPROVED_DIR=E:\Hackathon-Zero\Silver-Tier\AI-Employee-Vault\Approved
REJECTED_DIR=E:\Hackathon-Zero\Silver-Tier\AI-Employee-Vault\Rejected
DONE_DIR=E:\Hackathon-Zero\Silver-Tier\AI-Employee-Vault\Done
LOGS_DIR=E:\Hackathon-Zero\Silver-Tier\AI-Employee-Vault\Logs
WATCHERS_DIR=E:\Hackathon-Zero\Silver-Tier\AI-Employee-Vault\Watchers
