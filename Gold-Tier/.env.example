# ============================================
# Gold Tier AI Employee - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# --- Anthropic / Claude ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Email ---
EMAIL_ADDRESS=your_email@example.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_IMAP_SERVER=imap.gmail.com
EMAIL_SMTP_SERVER=smtp.gmail.com

# --- Twitter/X ---
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=

# --- Facebook ---
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=

# --- Instagram ---
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# --- Odoo (Accounting) ---
ODOO_URL=https://your-instance.odoo.com
ODOO_DATABASE=your_database
ODOO_USERNAME=your_username
ODOO_PASSWORD=your_password

# --- CEO Notification ---
CEO_EMAIL=ceo@example.com
CEO_NOTIFICATION_CHANNEL=email
# Options: email, slack, both

# --- Slack (Optional) ---
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# --- Application Settings ---
VAULT_PATH=./AI-Employee-Vault
WATCHER_POLL_INTERVAL=10
BRIEFING_TIME=08:00
ACCOUNTING_SYNC_INTERVAL=14400
LOG_LEVEL=INFO
