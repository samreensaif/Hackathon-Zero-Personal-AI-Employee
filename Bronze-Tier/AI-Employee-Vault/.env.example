# Gmail Watcher Environment Variables

# Path to your Gmail API credentials file
# Download from Google Cloud Console: https://console.cloud.google.com/
# This file should be in JSON format (OAuth 2.0 Desktop Application credentials)
GMAIL_CREDENTIALS_PATH=./credentials.json

# Interval in seconds between email checks (default: 120 = 2 minutes)
GMAIL_CHECK_INTERVAL=10
